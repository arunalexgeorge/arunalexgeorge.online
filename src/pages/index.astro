---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustBar from '../components/home/TrustBar.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import FeaturedProducts from '../components/home/FeaturedProducts.astro';
import Portfolio from '../components/home/Portfolio.astro';
import Industries from '../components/home/Industries.astro';
import Methodology from '../components/home/Methodology.astro';
import CTASection from '../components/home/CTASection.astro';
import { catalogueStats } from '../data/products';
---

<BaseLayout
  title="Home"
  seoTitle="Arun Alex George — Senior Odoo Developer & ERP Consultant, India"
  description={`Senior Odoo developer and ERP consultant in Kochi, Kerala. Custom Odoo modules, implementation, customization and migration — and ${catalogueStats.total} published Odoo apps and themes.`}
>
  <Hero />
  <TrustBar />
  <ServicesOverview />
  <FeaturedProducts />
  <Portfolio />
  <Industries />
  <Methodology />
  <CTASection />
</BaseLayout>
