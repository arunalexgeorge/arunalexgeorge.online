  { name: 'User Login History', desc: 'Keep a real history of every user login - who signed in, when and from which IP - with automatic 90-day cleanup.', price: 'FREE', category: 'Productivity', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/user_login_history' },
  { name: 'Webhook Sender Lite', desc: 'Fire a JSON webhook to any URL when you act on a record - a simple, reliable way to push Odoo events to other systems.', price: 'FREE', category: 'Productivity', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/record_webhook_notifier' },
  { name: 'Appointments & Online Booking', desc: 'Let customers book appointments online: services, staff, weekly availability and a public booking page - with a backend calendar. Odoo Community has no Appointments app.', price: '$69.00', category: 'Productivity', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/appointment_online_booking' },
  { name: 'Approval Chain Hub - Multi-Level Approvals for Any Model', desc: 'Generic, no-code approval workflows: approval types, multi-step approvers (sequential or parallel), amount thresholds, delegation, escalation and a full audit trail.', price: '$49.00', category: 'Productivity', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/approval_chain_hub' },
