  { name: 'Warranty & AMC Management', desc: 'Track product warranties and annual maintenance contracts - expiry reminders, renewals, claims and a printable certificate.', price: '$59.00', category: 'Operations', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/warranty_amc_management' },
  { name: 'Dental Lab Management System', desc: 'Complete dental laboratory management: cases, production, billing, portal & reports', price: '$500.01', category: 'Industry', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/dental_lab_management' },
];

const categories = ['All', ...new Set(products.map(p => p.category))];
---

<BaseLayout
  title="Products"
  description="Browse 140 Odoo apps and themes by Arun Alex George — AI tools, ERP modules, backend themes, and enterprise-grade solutions, all supporting Odoo 15.0 through 19.0."
>
  <section class="products-page section">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-header__label">Odoo App Store</p>
        <h1 class="section-header__title">Apps & Themes</h1>
        <p class="section-header__desc">
          {products.length} products published on the Odoo App Store — from AI-powered tools to enterprise-grade modules and premium themes.
          Every app is maintained for Odoo {ODOO_VERSIONS[0]} through {ODOO_VERSIONS[ODOO_VERSIONS.length - 1]}.
        </p>
      </div>

      <!-- Filters -->
      <div class="products-filters reveal" id="product-filters">
        {categories.map((cat) => (
          <button
            class={`chip products-filter ${cat === 'All' ? 'products-filter--active' : ''}`}
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Product Grid -->
      <div class="products-grid" id="product-grid">
        {products.map((product, i) => (
          <a
            class="products-card card card--accent reveal"
            href={product.href}
            target="_blank"
            rel="noopener noreferrer"
            data-category={product.category}
            data-delay={String(Math.min(i + 1, 4))}
          >
            <div class="products-card__top">
              <span class="badge">{product.category}</span>
              <span class="products-card__price">{product.price}</span>
            </div>
            <h3 class="products-card__name">{product.name}</h3>
            <p class="products-card__desc">{product.desc}</p>
            <div class="products-card__footer">
              <span class="products-card__versions" title={`Supported Odoo versions: ${product.versions.join(', ')}`}>
                <span class="products-card__versions-label">Odoo</span>
                <span class="products-card__version">{versionLabel(product.versions)}</span>
              </span>
              <span class="products-card__link">
                View on Store →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .products-page { padding-top: calc(72px + var(--space-16)); }

  .products-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-bottom: var(--space-10);
  }

  .products-filter--active {
    background: var(--color-accent-soft);
    border-color: var(--color-accent-border);
    color: var(--color-accent);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-6);
  }

  .products-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .products-card--hidden {
    display: none;
  }

  .products-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .products-card__price {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
  }

  .products-card__name {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .products-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .products-card__footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .products-card__link {
    margin-left: auto;
    font-weight: 600;
    color: var(--color-accent);
    transition: gap var(--duration-fast) var(--ease-out);
  }

  .products-card__versions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .products-card__versions-label {
    font-weight: 600;
  }

  .products-card__version {
    padding: 1px var(--space-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-full);
    font-family: var(--font-mono, var(--font-body));
    line-height: 1.6;
    white-space: nowrap;
  }
</style>

<script>
  const filters = document.querySelectorAll('.products-filter');
  const cards = document.querySelectorAll('.products-card') as NodeListOf<HTMLElement>;

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      filters.forEach((f) => f.classList.remove('products-filter--active'));
      btn.classList.add('products-filter--active');

      cards.forEach((card) => {
        if (filter === 'All' || card.dataset.category === filter) {
          card.classList.remove('products-card--hidden');
        } else {
          card.classList.add('products-card--hidden');
        }
      });
    });
  });
</script>
