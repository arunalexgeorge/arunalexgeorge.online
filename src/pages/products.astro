  { name: 'Payroll India - Statutory Salary, PF, ESI, PT & TDS', desc: 'Run Indian payroll on Odoo 19 Community: salary structures, payslips, Provident Fund (EPF), ESI, Professional Tax, TDS (new regime) and gratuity - no Enterprise needed.', price: '$79.00', category: 'HR', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/payroll_india_statutory' },
  { name: 'Shift Roster Planner', desc: 'Plan employee shifts on a calendar and publish the roster - the Planning app Community lacks.', price: '$59.00', category: 'HR', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/hr_shift_roster' },
  { name: 'BOM Where-Used', desc: 'Search any component to see every bill of materials that uses it - essential before changing or discontinuing a part.', price: 'FREE', category: 'Manufacturing', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/mrp_bom_where_used' },
  { name: 'MO Progress Bar', desc: 'See how far each manufacturing order has progressed at a glance - a progress bar right in the manufacturing orders list.', price: 'FREE', category: 'Manufacturing', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/mrp_progress_bar' },
  { name: 'Manufacturing Quality Checklist', desc: 'Add a simple pass/fail quality checklist to manufacturing orders - with live progress and a failed-check warning.', price: 'FREE', category: 'Manufacturing', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/mrp_quality_checklist' },
  { name: 'Quality Control Pro', desc: 'Quality control points, pass/fail/measure checks and non-conformance alerts on your transfers - the Quality app Community lacks.', price: '$79.00', category: 'Manufacturing', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/quality_control_pro' },
  { name: 'Drip Campaigns - Marketing Automation & Sequences', desc: 'Automated multi-step campaigns over any model: timed email sequences and server actions, with participants, scheduling and a full run history. Community-friendly marketing automation.', price: '$69.00', category: 'Marketing', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/drip_campaign_builder' },
  { name: 'Survey NPS & CSAT', desc: 'Flag a 0-10 question as your NPS question and get an automatic Net Promoter Score - promoters, passives, detractors.', price: '$39.00', category: 'Marketing', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/survey_nps_feedback' },
  { name: 'Website WhatsApp Button', desc: 'Add a floating WhatsApp chat button to your website - one tap to start a conversation, no code and no third-party scripts.', price: 'FREE', category: 'Website', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/website_whatsapp_chat' },
  { name: 'WhatsApp Cloud API Connector', desc: 'Send and receive WhatsApp messages from Odoo using the official Meta WhatsApp Cloud API: message templates, chatter integration, inbound webhook, delivery/read receipts. Community alternative to Enterprise WhatsApp.', price: '$198.99', category: 'Website', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/whatsapp_cloud_connector' },
  { name: 'eSignature Hub - Sign Documents Online', desc: 'Send documents for electronic signature: signers, ordered signing, portal signing with a drawn signature, audit trail and a signature certificate. A Community alternative to Enterprise Sign.', price: '$69.00', category: 'Website', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/esign_signature_hub' },
  { name: 'Service Report', desc: 'Record on-site service jobs - work done, parts, time and a customer signature - and print a professional PDF.', price: 'FREE', category: 'Operations', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/service_report_lite' },
