  { name: 'Employee Directory', desc: 'A clean, searchable staff directory - photos, job titles, departments and contact details - available to every employee.', price: 'FREE', category: 'HR', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/hr_employee_directory' },
