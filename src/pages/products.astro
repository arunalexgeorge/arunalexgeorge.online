  { name: 'Negative Stock Report', desc: 'Instantly find products with a negative on-hand quantity - usually a sign of a data or process problem to fix.', price: 'FREE', category: 'Warehouse', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/stock_negative_stock_report' },
  { name: 'Product Barcode Generator (EAN-13)', desc: 'Generate a valid, unique EAN-13 barcode for any product in one click - individually or in bulk.', price: 'FREE', category: 'Warehouse', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/product_ean13_autogen' },
