  { name: 'Field Service Management', desc: 'Schedule on-site jobs and let field workers run them from a mobile app: start, log work and complete with time tracking. Odoo Community has no Field Service app.', price: '$79.00', category: 'Operations', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/fsm_field_jobs' },
