  { name: 'Appraisal & OKR', desc: 'Run employee performance reviews with weighted goals/KPIs and an automatic overall score - the Appraisal app Community lacks.', price: '$49.00', category: 'HR', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/hr_appraisal_okr' },
  { name: 'Employee Geo Attendance & Field Visit Tracking', desc: 'GPS-verified employee check-in/out for office attendance and customer field visits, with radius validation, admin override, dashboards and reports.', price: '$150.00', category: 'HR', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/employee_geo_attendance' },
