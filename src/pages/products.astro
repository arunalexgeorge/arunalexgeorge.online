  { name: 'CRM AI Copilot - Lead Scoring & Sales Assistant', desc: 'AI lead scoring (Hot/Warm/Cold), plus one-click summaries, next-best-action and outreach email drafts - on your own AI key.', price: '$49.00', category: 'AI', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/crm_ai_copilot' },
