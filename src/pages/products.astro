  { name: 'E-Invoicing Framework (Base)', desc: 'Shared engine for country e-invoicing connectors: EDI state machine, QR rendering, document storage, audit log and pluggable per-country generation/clearance hooks.', price: 'FREE', category: 'Productivity', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/einvoice_connector_base' },
