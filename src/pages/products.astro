---
import BaseLayout from '../layouts/BaseLayout.astro';

// Every module is published for these Odoo series on the App Store.
const ODOO_VERSIONS = ['15.0', '16.0', '17.0', '18.0', '19.0'];

// Collapse a contiguous run of series into "15.0 – 19.0"; list the rest.
function versionLabel(versions: string[]) {
  const idx = versions.map((v) => ODOO_VERSIONS.indexOf(v));
  const contiguous = versions.length > 1 && idx.every((n, i) => i === 0 || n === idx[i - 1] + 1);
  return contiguous ? `${versions[0]} – ${versions[versions.length - 1]}` : versions.join(', ');
}

const products = [
  { name: 'AI Email & Reply Writer', desc: 'Draft and improve emails with AI, right inside Odoo\'s composer - tell it what to say, pick a tone, and get a polished email. Bring your own key via the free AI Gateway.', price: 'FREE', category: 'AI', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/ai_mail_assistant' },
  { name: 'AI Gateway', desc: 'Reusable BYO-key LLM gateway (Claude / OpenAI / Ollama) with provider routing, usage logging and cost tracking — the shared foundation for AI-powered Odoo apps.', price: 'FREE', category: 'AI', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/ai_gateway' },
  { name: 'AI Lead Summary', desc: 'Summarize a lead\'s whole conversation into a few bullet points with AI - get up to speed in seconds.', price: 'FREE', category: 'AI', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/ai_thread_summary' },
  { name: 'AI Product Descriptions', desc: 'Generate compelling product sales descriptions with AI, in one click - choose tone, length, language and key features. Bring your own key via the free AI Gateway.', price: 'FREE', category: 'AI', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/ai_product_copywriter' },
  { name: 'AI Translator', desc: 'Translate any text into any language with AI, right inside Odoo - bring your own key via the AI Gateway.', price: 'FREE', category: 'AI', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/ai_translate_field' },
  { name: 'AI Chat over your ERP', desc: 'Ask questions about your Odoo data in plain language and get grounded answers. A chat assistant with retrieval over the models you choose - it only reads what the user is allowed to see.', price: '$89.00', category: 'AI', versions: ODOO_VERSIONS, href: 'https://apps.odoo.com/apps/modules/19.0/ai_erp_chat' },
