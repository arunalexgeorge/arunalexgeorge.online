---
/* ERP Rescue — interactive game (server-rendered shell, vanilla TS engine). */
import { MODULES } from './erp-rescue/types';

const controls = [
  { key: 'Click / Tap', desc: 'Fix a failing module' },
  { key: '1 – 9', desc: 'Fix module by number' },
  { key: 'P / Esc', desc: 'Pause' },
  { key: 'M', desc: 'Mute' },
];
---

<section id="erp-rescue" class="erp" aria-label="ERP Rescue — interactive game">
  <!-- ===================== INTRO ===================== -->
  <div class="erp__screen erp-intro" data-screen="intro">
    <span class="erp-intro__eyebrow">Interactive · Play</span>
    <h2 class="erp-intro__title">ERP&nbsp;Rescue</h2>
    <p class="erp-intro__lede">
      Nine business modules. One operator: you. Systems drift into failure —
      keep them online, chain combos, and survive escalating waves before the
      company goes dark.
    </p>

    <div class="erp-intro__legend" aria-hidden="true">
      <span class="erp-legend erp-legend--idle"><i></i> Stable</span>
      <span class="erp-legend erp-legend--charging"><i></i> Degrading</span>
      <span class="erp-legend erp-legend--warning"><i></i> Warning</span>
      <span class="erp-legend erp-legend--critical"><i></i> Critical</span>
    </div>

    <ul class="erp-intro__tips">
      <li>Tap modules the moment they light up — the later you catch them, the more points and uptime you recover.</li>
      <li>Consecutive fixes build a <strong>combo multiplier</strong>. Let one fail and the combo resets.</li>
      <li>Ignore the dim, stable modules — poking a healthy system costs you uptime.</li>
    </ul>

    <div class="erp-intro__stats">
      <div class="erp-stat"><span class="erp-stat__val" id="erp-best-intro">0</span><span class="erp-stat__label">Best score</span></div>
      <div class="erp-stat"><span class="erp-stat__val" id="erp-plays-intro">0</span><span class="erp-stat__label">Shifts played</span></div>
    </div>

    <button class="btn btn--primary btn--lg erp-intro__start" id="erp-start" type="button">
      Start Shift
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
    </button>

    <dl class="erp-intro__controls">
      {controls.map((c) => (
        <div class="erp-control"><dt>{c.key}</dt><dd>{c.desc}</dd></div>
      ))}
    </dl>
    <p class="erp-intro__hint">Rumour has it the systems respond to those who speak fluent <span>Odoo</span>.</p>
  </div>

  <!-- ===================== GAME ===================== -->
  <div class="erp__screen erp-game" data-screen="game" hidden>
    <div class="erp-hud">
      <div class="erp-hud__stat">
        <span class="erp-hud__label">Score</span>
        <span class="erp-hud__value" id="erp-score">0</span>
      </div>
      <div class="erp-hud__stat">
        <span class="erp-hud__label">Wave</span>
        <span class="erp-hud__value" id="erp-wave">1</span>
      </div>
      <div class="erp-hud__stat">
        <span class="erp-hud__label">Combo</span>
        <span class="erp-hud__value erp-hud__combo" id="erp-combo" data-active="false">—</span>
      </div>

      <div class="erp-hud__uptime">
        <div class="erp-hud__uptime-head">
          <span class="erp-hud__label">Uptime</span>
          <span class="erp-hud__value" id="erp-uptime-val">100%</span>
        </div>
        <div class="erp-uptime-track"><div class="erp-uptime-fill" id="erp-uptime-fill" data-health="ok"></div></div>
      </div>

      <div class="erp-hud__actions">
        <button class="erp-icon-btn" id="erp-mute" type="button" aria-pressed="false" aria-label="Mute sound" title="Mute (M)">
          <svg class="erp-i-sound" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          <svg class="erp-i-muted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
        </button>
        <button class="erp-icon-btn" id="erp-pause" type="button" aria-pressed="false" aria-label="Pause game" title="Pause (P)">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
        </button>
      </div>
    </div>

    <div class="erp-board">
      <div class="erp-grid" id="erp-grid" role="group" aria-label="Operations grid">
        {MODULES.map((m, i) => (
          <button
            class="erp-cell"
            type="button"
            data-index={i}
            data-name={m.name}
            data-status="idle"
            tabindex="-1"
            aria-label={`${m.name} — stable`}
          >
            <span class="erp-cell__fill" aria-hidden="true"></span>
            <span class="erp-cell__key" aria-hidden="true">{i + 1}</span>
            <svg class="erp-cell__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={m.icon} />
            <span class="erp-cell__code">{m.code}</span>
            <span class="erp-cell__status">stable</span>
          </button>
        ))}
      </div>

      <div class="erp-banner" id="erp-banner" aria-hidden="true"></div>
      <div class="erp__flash" id="erp-flash" data-tone="bad" aria-hidden="true"></div>

      <div class="erp-pause" id="erp-pause-overlay" hidden>
        <div class="erp-pause__inner">
          <span class="erp-pause__title">Paused</span>
          <span class="erp-pause__hint">Click, press P or Esc to resume</span>
        </div>
      </div>
    </div>

    <p class="erp-sr-only" id="erp-live" aria-live="polite"></p>
    <p class="erp-sr-only" id="erp-alert" aria-live="assertive"></p>
  </div>

  <!-- ===================== GAME OVER ===================== -->
  <div class="erp__screen erp-over" data-screen="over" hidden>
    <span class="erp-over__badge" id="erp-best-badge" hidden>★ New personal best</span>
    <span class="erp-over__eyebrow">Shift complete</span>
    <div class="erp-over__score" id="erp-final-score">0</div>
    <div class="erp-over__rank">Rank achieved · <strong id="erp-final-rank">IT Intern</strong></div>

    <div class="erp-over__stats">
      <div class="erp-stat"><span class="erp-stat__val" id="erp-final-best">0</span><span class="erp-stat__label">Best</span></div>
      <div class="erp-stat"><span class="erp-stat__val" id="erp-final-wave">1</span><span class="erp-stat__label">Waves</span></div>
      <div class="erp-stat"><span class="erp-stat__val" id="erp-final-fixes">0</span><span class="erp-stat__label">Fixes</span></div>
      <div class="erp-stat"><span class="erp-stat__val" id="erp-final-combo">×0</span><span class="erp-stat__label">Best combo</span></div>
    </div>

    <div class="erp-over__ach">
      <span class="erp-over__ach-title">Badges earned</span>
      <div class="erp-over__ach-list" id="erp-ach-list"></div>
    </div>

    <div class="erp-share">
      <span class="erp-share__title">Share your score</span>
      <div class="erp-share__row">
        <button class="btn btn--outline erp-share__btn" id="erp-share-native" type="button" hidden>Share</button>
        <a class="erp-share__icon" id="erp-share-x" href="#" target="_blank" rel="noopener" aria-label="Share on X" title="Share on X">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a class="erp-share__icon" id="erp-share-in" href="#" target="_blank" rel="noopener" aria-label="Share on LinkedIn" title="Share on LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        <a class="erp-share__icon" id="erp-share-wa" href="#" target="_blank" rel="noopener" aria-label="Share on WhatsApp" title="Share on WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37s-1.05 1.02-1.05 2.5 1.08 2.9 1.23 3.1c.15.2 2.12 3.24 5.14 4.54.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 21.7h-.02a9.6 9.6 0 0 1-4.9-1.34l-.35-.2-3.64.95.97-3.55-.23-.36a9.62 9.62 0 0 1 14.94-11.9 9.56 9.56 0 0 1 2.82 6.8c0 5.3-4.32 9.6-9.6 9.6zM20.52 3.48A11.96 11.96 0 0 0 12.04 0C5.46 0 .1 5.35.1 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.3-1.65a11.9 11.9 0 0 0 5.73 1.46h.01c6.58 0 11.94-5.35 11.94-11.93a11.86 11.86 0 0 0-3.46-8.4z"/></svg>
        </a>
        <button class="btn btn--outline erp-share__btn" id="erp-share-copy" type="button">Copy</button>
        <a class="erp-share__icon" id="erp-share-download" href="#" download="erp-rescue-score.png" aria-label="Download score card" title="Download score card">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </a>
      </div>
      <canvas class="erp-share__card" id="erp-card" width="1200" height="630" aria-label="Generated score card"></canvas>
    </div>

    <div class="erp-over__actions">
      <button class="btn btn--primary btn--lg" id="erp-again" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        Play again
      </button>
    </div>

    <div class="erp-cta">
      <p class="erp-cta__text">Keeping real systems online is my day job — Odoo ERP, automation & cloud infrastructure that doesn't go dark.</p>
      <a class="btn btn--outline erp-cta__link" href="/contact">Let's build something reliable →</a>
    </div>
  </div>

  <div class="erp__toasts" id="erp-toast"></div>
</section>

<noscript>
  <p class="erp-noscript">ERP Rescue is an interactive game and needs JavaScript enabled. Meanwhile, explore my <a href="/services">services</a> or <a href="/contact">get in touch</a>.</p>
</noscript>

<style>
  .erp {
    --erp-warn: #F59E0B;
    --erp-warn-soft: rgba(245, 158, 11, 0.12);
    --erp-crit: #EF4444;
    --erp-crit-soft: rgba(239, 68, 68, 0.14);
    position: relative;
    max-width: 640px;
    margin-inline: auto;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--space-6), 4vw, var(--space-10));
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .erp::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% -10%, var(--color-accent-glow) 0%, transparent 55%);
    pointer-events: none;
  }
  .erp > * { position: relative; }

  /* ---------- Intro ---------- */
  .erp-intro { text-align: center; }
  .erp-intro__eyebrow {
    font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-widest);
    text-transform: uppercase; color: var(--color-accent);
  }
  .erp-intro__title {
    font-size: clamp(var(--text-4xl), 8vw, var(--text-6xl));
    margin: var(--space-3) 0 var(--space-4);
  }
  .erp-intro__lede {
    max-width: 46ch; margin: 0 auto var(--space-6);
    color: var(--color-text-secondary); font-size: var(--text-lg);
  }
  .erp-intro__legend {
    display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .erp-legend {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-wide);
    color: var(--color-text-tertiary); text-transform: uppercase;
  }
  .erp-legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .erp-legend--idle i { background: var(--color-text-muted); }
  .erp-legend--charging i { background: var(--color-accent); }
  .erp-legend--warning i { background: var(--erp-warn); }
  .erp-legend--critical i { background: var(--erp-crit); }

  .erp-intro__tips {
    max-width: 52ch; margin: 0 auto var(--space-6); text-align: left;
    display: grid; gap: var(--space-2);
  }
  .erp-intro__tips li {
    position: relative; padding-left: var(--space-6);
    color: var(--color-text-secondary); font-size: var(--text-sm); line-height: var(--leading-normal);
  }
  .erp-intro__tips li::before {
    content: '›'; position: absolute; left: var(--space-2); top: 0;
    color: var(--color-accent); font-weight: 700;
  }
  .erp-intro__tips strong { color: var(--color-text); }

  .erp-intro__stats, .erp-over__stats {
    display: flex; justify-content: center; gap: var(--space-8); margin-bottom: var(--space-6);
  }
  .erp-stat { display: flex; flex-direction: column; align-items: center; }
  .erp-stat__val {
    font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; color: var(--color-text);
  }
  .erp-stat__label {
    font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-text-tertiary);
  }

  .erp-intro__start { margin-bottom: var(--space-6); }

  .erp-intro__controls {
    display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-4);
  }
  .erp-control { display: inline-flex; align-items: center; gap: var(--space-2); }
  .erp-control dt {
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    color: var(--color-text); background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    padding: 2px var(--space-2);
  }
  .erp-control dd { font-size: var(--text-xs); color: var(--color-text-tertiary); }
  .erp-intro__hint { font-size: var(--text-xs); color: var(--color-text-muted); }
  .erp-intro__hint span { color: var(--color-text-tertiary); font-family: var(--font-mono); }

  /* ---------- HUD ---------- */
  .erp-hud {
    display: flex; align-items: center; gap: var(--space-4);
    flex-wrap: wrap; margin-bottom: var(--space-5);
  }
  .erp-hud__stat { display: flex; flex-direction: column; min-width: 48px; }
  .erp-hud__label {
    font-size: var(--text-xs); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-text-tertiary);
  }
  .erp-hud__value {
    font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700;
    color: var(--color-text); font-variant-numeric: tabular-nums;
  }
  .erp-hud__combo { color: var(--color-text-muted); }
  .erp-hud__combo[data-active="true"] { color: var(--color-accent); }

  .erp-hud__uptime { flex: 1; min-width: 140px; }
  .erp-hud__uptime-head { display: flex; justify-content: space-between; align-items: baseline; }
  .erp-uptime-track {
    height: 8px; border-radius: var(--radius-full);
    background: var(--color-bg-tertiary); overflow: hidden; margin-top: var(--space-1);
  }
  .erp-uptime-fill {
    height: 100%; width: 100%; border-radius: inherit;
    background: var(--color-accent);
    transition: width 200ms var(--ease-out), background-color var(--duration-normal) var(--ease-out);
  }
  .erp-uptime-fill[data-health="warn"] { background: var(--erp-warn); }
  .erp-uptime-fill[data-health="crit"] { background: var(--erp-crit); }

  .erp-hud__actions { display: flex; gap: var(--space-2); }
  .erp-icon-btn {
    width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md); color: var(--color-text-secondary);
    border: 1px solid var(--color-border); background: var(--color-bg-tertiary);
    transition: all var(--duration-fast) var(--ease-out);
  }
  .erp-icon-btn:hover { color: var(--color-text); border-color: var(--color-border-hover); }
  .erp-i-muted { display: none; }
  #erp-mute[data-muted="true"] .erp-i-sound { display: none; }
  #erp-mute[data-muted="true"] .erp-i-muted { display: block; }

  /* ---------- Board / grid ---------- */
  .erp-board { position: relative; }
  .erp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }

  .erp-cell {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-1); aspect-ratio: 1 / 1;
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    background: var(--color-bg-elevated); color: var(--color-text-tertiary);
    transition: border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out),
                opacity var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .erp-cell__fill {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: calc(var(--stress, 0) * 100%);
    background: currentColor; opacity: 0.1; pointer-events: none;
    transition: height 120ms linear;
  }
  .erp-cell__key {
    position: absolute; top: 6px; right: 8px;
    font-family: var(--font-mono); font-size: 10px; color: var(--color-text-muted);
  }
  .erp-cell__icon { width: 26px; height: 26px; }
  .erp-cell__code {
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    letter-spacing: var(--tracking-wide); color: var(--color-text);
  }
  .erp-cell__name { display: none; }
  .erp-cell__status {
    font-size: 9px; letter-spacing: var(--tracking-wider);
    text-transform: uppercase; color: currentColor; opacity: 0.85;
  }

  /* status colours */
  .erp-cell[data-status="idle"] { color: var(--color-text-muted); opacity: 0.5; }
  .erp-cell[data-status="charging"] {
    color: var(--color-accent); opacity: 1;
    border-color: var(--color-accent-border);
  }
  .erp-cell[data-status="warning"] {
    color: var(--erp-warn); opacity: 1;
    border-color: var(--erp-warn); box-shadow: 0 0 0 1px var(--erp-warn-soft), 0 0 20px var(--erp-warn-soft);
  }
  .erp-cell[data-status="critical"] {
    color: var(--erp-crit); opacity: 1;
    border-color: var(--erp-crit); box-shadow: 0 0 0 1px var(--erp-crit-soft), 0 0 26px var(--erp-crit-soft);
    animation: erp-crit-pulse 0.7s ease-in-out infinite;
  }
  .erp-cell[data-status="down"] { color: var(--color-text-muted); opacity: 0.28; filter: grayscale(1); }
  .erp-cell:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  @keyframes erp-crit-pulse {
    0%, 100% { box-shadow: 0 0 0 1px var(--erp-crit-soft), 0 0 16px var(--erp-crit-soft); }
    50% { box-shadow: 0 0 0 1px var(--erp-crit), 0 0 30px var(--erp-crit-soft); }
  }

  /* effect classes */
  .erp-cell--fix { animation: erp-fix 0.4s var(--ease-out); }
  .erp-cell--fix-crit { animation: erp-fix 0.5s var(--ease-out); }
  @keyframes erp-fix {
    0% { transform: scale(1); box-shadow: 0 0 0 2px var(--color-accent); }
    40% { transform: scale(0.94); box-shadow: 0 0 24px var(--color-accent-soft); }
    100% { transform: scale(1); box-shadow: none; }
  }
  .erp-cell--down { animation: erp-shake 0.4s ease-in-out; }
  @keyframes erp-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-5px); } 40% { transform: translateX(5px); }
    60% { transform: translateX(-3px); } 80% { transform: translateX(3px); }
  }
  .erp-cell--nudge { animation: erp-nudge 0.2s ease-in-out; }
  @keyframes erp-nudge { 0%,100% { transform: translateX(0);} 50% { transform: translateX(-3px);} }

  .erp-pulse { animation: erp-pulse 0.3s var(--ease-out); }
  @keyframes erp-pulse { 0%,100% { transform: scale(1);} 50% { transform: scale(1.25);} }

  /* ---------- Banner / flash / pause ---------- */
  .erp-banner {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(var(--text-3xl), 8vw, var(--text-5xl));
    letter-spacing: var(--tracking-wide); color: var(--color-accent);
    text-shadow: 0 0 40px var(--color-accent-soft);
    opacity: 0; transform: scale(0.9); pointer-events: none;
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .erp-banner--on { opacity: 1; transform: scale(1); }

  .erp__flash {
    position: absolute; inset: 0; pointer-events: none; opacity: 0; border-radius: var(--radius-lg);
  }
  .erp__flash[data-tone="bad"] { background: radial-gradient(circle, var(--erp-crit-soft), transparent 70%); }
  .erp__flash[data-tone="good"] { background: radial-gradient(circle, var(--color-accent-soft), transparent 70%); }
  .erp__flash--on { animation: erp-flash 0.45s var(--ease-out); }
  @keyframes erp-flash { 0% { opacity: 0.9; } 100% { opacity: 0; } }

  .erp-pause {
    position: absolute; inset: 0; z-index: 5;
    display: flex; align-items: center; justify-content: center;
    background: rgba(9, 9, 11, 0.72); backdrop-filter: blur(6px);
    border-radius: var(--radius-lg); cursor: pointer;
  }
  :global([data-theme="light"]) .erp-pause { background: rgba(255, 255, 255, 0.7); }
  .erp-pause__inner { text-align: center; display: grid; gap: var(--space-2); }
  .erp-pause__title { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 700; color: var(--color-text); }
  .erp-pause__hint { font-size: var(--text-sm); color: var(--color-text-tertiary); }

  /* ---------- Game over ---------- */
  .erp-over { text-align: center; }
  .erp-over__badge {
    display: inline-block; margin-bottom: var(--space-3);
    padding: var(--space-1) var(--space-4); border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-wide);
    color: var(--color-accent); background: var(--color-accent-soft); border: 1px solid var(--color-accent-border);
  }
  .erp-over__eyebrow {
    display: block; font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-widest);
    text-transform: uppercase; color: var(--color-text-tertiary);
  }
  .erp-over__score {
    font-family: var(--font-display); font-weight: 700; line-height: 1;
    font-size: clamp(3.5rem, 14vw, 6rem);
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    margin: var(--space-2) 0;
  }
  .erp-over__rank { color: var(--color-text-secondary); margin-bottom: var(--space-6); }
  .erp-over__rank strong { color: var(--color-accent); }

  .erp-over__ach { margin-bottom: var(--space-6); }
  .erp-over__ach-title, .erp-share__title {
    display: block; font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-text-tertiary); margin-bottom: var(--space-3);
  }
  .erp-over__ach-list {
    display: flex; flex-wrap: wrap; gap: var(--space-2); justify-content: center; min-height: 32px;
  }
  .erp-over__ach-empty { font-size: var(--text-sm); color: var(--color-text-muted); }

  /* ---------- Share ---------- */
  .erp-share { margin-bottom: var(--space-6); }
  .erp-share__row {
    display: flex; flex-wrap: wrap; gap: var(--space-2); justify-content: center; align-items: center;
    margin-bottom: var(--space-4);
  }
  .erp-share__btn { padding: var(--space-2) var(--space-4); font-size: var(--text-sm); }
  .erp-share__icon {
    width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md); color: var(--color-text-secondary);
    border: 1px solid var(--color-border); background: var(--color-bg-tertiary);
    transition: all var(--duration-fast) var(--ease-out);
  }
  .erp-share__icon:hover { color: var(--color-accent); border-color: var(--color-accent-border); transform: translateY(-2px); }
  .erp-share__card {
    width: 100%; max-width: 360px; height: auto; border-radius: var(--radius-md);
    border: 1px solid var(--color-border); margin: 0 auto; display: block;
  }

  .erp-over__actions { margin-bottom: var(--space-8); }

  .erp-cta {
    border-top: 1px solid var(--color-border); padding-top: var(--space-6);
    display: grid; gap: var(--space-4); justify-items: center;
  }
  .erp-cta__text { max-width: 46ch; color: var(--color-text-secondary); font-size: var(--text-sm); }

  /* ---------- Utilities ---------- */
  .erp-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .erp-noscript {
    max-width: 640px; margin: var(--space-8) auto; text-align: center;
    color: var(--color-text-secondary);
  }
  .erp-noscript a { color: var(--color-accent); }

  @media (max-width: 480px) {
    .erp { padding: var(--space-5) var(--space-4); }
    .erp-hud { gap: var(--space-3); }
    .erp-hud__value { font-size: var(--text-lg); }
    .erp-grid { gap: var(--space-2); }
    .erp-cell__icon { width: 22px; height: 22px; }
    .erp-intro__stats, .erp-over__stats { gap: var(--space-5); }
  }
</style>

<!-- Global styles for dynamically-created elements (outside Astro's scope hashing) -->
